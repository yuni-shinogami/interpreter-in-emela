pub enum Token {
  Illegal(String)
  Eof
  Ident(String)
  Int(Int)
  Assign
  Plus
  Comma
  Semicolon
  LParen
  RParen
  LBrace
  RBrace
  Function
  Let
} derive Eq, Show

pub fn lookup_ident(word: String) -> Token {
  word match {
    "fn"  -> Function
    "let" -> Let
    _     -> Ident(word)
  }
}
